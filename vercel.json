{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "npm ci && npm run build",
  "functions": {
    "backend/wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.venv/**,tmp/**,output/**,backend/tests/**,tests/**,**/*.pdf}"
    }
  }
}
