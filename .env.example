DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional; without it the backend uses the public OSRM demonstration service.
MAPBOX_TOKEN=
# Optional provider override for a production OSRM-compatible deployment.
ROUTING_BASE_URL=https://router.project-osrm.org
# Optional: shared caching. Vercel works without Redis using signed trip tokens.
# Use the provider's TCP connection URL, not its HTTPS REST endpoint.
REDIS_URL=
